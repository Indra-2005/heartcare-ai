# NOTE: If .env, .conda, __pycache__, or .pytest_cache were previously
# committed, run the following to stop tracking them (files stay locally):
#   git rm -r --cached .conda .pytest_cache __pycache__
#   git rm --cached .env
# Then commit the result. To fully purge from history (rewrites history):
#   pip install git-filter-repo
#   git filter-repo --invert-paths --path .env
#   git push --force