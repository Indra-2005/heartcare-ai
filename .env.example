# HeartCare AI — Environment Configuration Template
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
#
# SECURITY: Never commit .env to version control.
# .env is already listed in .gitignore.

# ── Flask ─────────────────────────────────────────────────────────────────────
# Generate a secure key with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=replace_with_a_64_character_random_hex_string

# ── Database ──────────────────────────────────────────────────────────────────
# Local PostgreSQL example:
#   DATABASE_URL=postgresql://username:password@localhost:5432/heartcare_db
#
# Heroku / Render example (use the exact URL provided by the platform):
#   DATABASE_URL=postgresql://user:pass@host:5432/dbname
#
# Note: If your platform provides a 'postgres://' URL, config.py will
# automatically convert it to 'postgresql://' for SQLAlchemy compatibility.
DATABASE_URL=postgresql://username:password@localhost:5432/heartcare_db

# ── Deployment ────────────────────────────────────────────────────────────────
# PORT is set automatically by Heroku/Render — do not set it manually there.
# Uncomment for local override:
# PORT=8080
